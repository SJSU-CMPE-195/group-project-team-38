{
  "name": "native",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "dev": "expo start --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "web": "expo start --web",
    "check-types": "tsc --noEmit",
    "e2e": "bun run e2e:prepare && bun run e2e:smoke",
    "e2e:auth-cycle": "MAESTRO_DRIVER_STARTUP_TIMEOUT=180000 maestro test .maestro/auth-cycle.yaml",
    "e2e:prepare": "bun ./scripts/e2e-prepare-ios.mjs",
    "e2e:smoke": "MAESTRO_DRIVER_STARTUP_TIMEOUT=180000 maestro test .maestro/smoke.yaml",
    "e2e:demo": "bun run e2e:prepare && MAESTRO_DRIVER_STARTUP_TIMEOUT=180000 maestro test .maestro/nurse-demo.yaml",
    "e2e:demo:safe": "bun run e2e:prepare && MAESTRO_DRIVER_STARTUP_TIMEOUT=180000 maestro test .maestro/nurse-safe-path.yaml",
    "e2e:demo:conflict": "bun run e2e:prepare && MAESTRO_DRIVER_STARTUP_TIMEOUT=180000 maestro test .maestro/nurse-conflict-ai.yaml",
    "e2e:doctor": "sh -c 'for f in .maestro/*.yaml .maestro/subflows/*.yaml; do maestro check-syntax \"$f\"; done'"
  },
  "dependencies": {
    "@better-auth/expo": "catalog:",
    "@convex-dev/better-auth": "catalog:",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5",
    "@meditag/backend": "workspace:*",
    "@meditag/env": "workspace:*",
    "@react-navigation/drawer": "^7.3.9",
    "@react-navigation/elements": "^2.8.1",
    "@tanstack/react-form": "catalog:",
    "better-auth": "catalog:",
    "convex": "catalog:",
    "dotenv": "catalog:",
    "expo": "^54.0.23",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.10",
    "expo-font": "~14.0.9",
    "expo-haptics": "^15.0.7",
    "expo-linking": "~8.0.8",
    "expo-network": "~8.0.7",
    "expo-router": "~6.0.14",
    "expo-secure-store": "~15.0.7",
    "expo-status-bar": "~3.0.8",
    "heroui-native": "^1.0.0-rc.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "^2.28.0",
    "react-native-keyboard-controller": "1.18.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.1.18",
    "uniwind": "^1.3.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@meditag/config": "workspace:*",
    "@types/node": "^24.10.0",
    "@types/react": "~19.1.0",
    "typescript": "catalog:"
  }
}
