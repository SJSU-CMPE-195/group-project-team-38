{
  "name": "meditag",
  "private": true,
  "version": "0.0.1",
  "workspaces": [
    "src/apps/*",
    "src/packages/*"
  ],
  "scripts": {
    "api:dev": "pnpm --filter api dev",
    "db:up": "docker compose -f src/infra/docker/docker-compose.yml up -d",
    "db:down": "docker compose -f src/infra/docker/docker-compose.yml down",
    "db:reset": "docker compose -f src/infra/docker/docker-compose.yml down -v && docker compose -f infra/docker/docker-compose.yml up -d",
    "db:migrate": "pnpm --filter api prisma migrate dev",
    "db:seed": "pnpm --filter api prisma db seed"
  }
}
