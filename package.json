{
  "name": "meditag",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "typescript": "^5",
      "convex": "^1.31.2",
      "better-auth": "1.4.9",
      "@convex-dev/better-auth": "^0.10.9",
      "@tanstack/react-form": "^1.28.0",
      "@better-auth/expo": "1.4.9"
    }
  },
  "type": "module",
  "scripts": {
    "postinstall": "bun scripts/apply-react-native-turbomodule-patch.mjs",
    "dev": "turbo run dev",
    "docs:list": "bun scripts/docs-list.ts",
    "build": "turbo run build",
    "test:backend": "turbo run test --filter=@meditag/backend",
    "test:native": "turbo run test --filter=native",
    "coverage:backend": "turbo run coverage --filter=@meditag/backend",
    "check-types": "turbo run check-types",
    "dev:native": "turbo run dev --filter=native",
    "dev:web": "turbo run dev --filter=web",
    "dev:server": "turbo run dev --filter=@meditag/backend",
    "dev:setup": "turbo run dev:setup --filter=@meditag/backend",
    "seed:demo": "cd packages/backend && bun run seed:demo",
    "test:e2e": "turbo run e2e",
    "test:e2e:web": "turbo run e2e --filter=web",
    "test:e2e:native": "turbo run e2e --filter=native",
    "test:e2e:native:demo": "turbo run e2e:demo --filter=native",
    "test:e2e:native:nfc-toggle": "turbo run e2e:nfc-toggle --filter=native",
    "stress:test:web": "bun tests/e2e/web-health-stress.mjs",
    "check": "oxlint && oxfmt --write"
  },
  "dependencies": {
    "@meditag/env": "workspace:*",
    "convex": "^1.37.0",
    "dotenv": "catalog:",
    "react-native-enriched-markdown": "^0.5.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@meditag/config": "workspace:*",
    "oxfmt": "^0.26.0",
    "oxlint": "^1.41.0",
    "turbo": "^2.6.3",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.7"
}
